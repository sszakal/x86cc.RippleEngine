<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>

        <IsPackable>true</IsPackable>
        <PackageId>x86cc.RippleEngine.Storage</PackageId>
        <Description>RippleEngine Postgres coordination surface: the schema migration, the claim/settle/recover SQL (FOR UPDATE SKIP LOCKED) and the schedule_order stamping shared by every fan-out provider.</Description>
        <PackageTags>$(PackageTags);dapper;fluentmigrator</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Dapper" />
        <PackageReference Include="FluentMigrator" />
        <PackageReference Include="FluentMigrator.Runner.Postgres" />
        <PackageReference Include="Npgsql" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\x86cc.RippleEngine.Core\x86cc.RippleEngine.Core.csproj" />
    </ItemGroup>

    <!-- The fan-out INSERT…SELECT builder (WaveInsertSql) is a shared internal for the queryable-source
         provider packages, so the schedule_order/type_key SQL lives in exactly one place. -->
    <ItemGroup>
        <InternalsVisibleTo Include="x86cc.RippleEngine.MartenDb" />
        <InternalsVisibleTo Include="x86cc.RippleEngine.EntityFrameworkCore" />
    </ItemGroup>

</Project>
