<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>

        <IsPackable>true</IsPackable>
        <PackageId>x86cc.RippleEngine.Hosting</PackageId>
        <Description>The one-call RippleEngine setup: builder.AddRippleEngine(o => ...).AddHandler&lt;TWave, TRipple, THandler&gt;() wires storage, the schema migration, the engine's hosted services, the shutdown budget, metrics and the dashboard. Start here.</Description>
        <PackageTags>$(PackageTags);hosting;dependency-injection</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
        <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" />
        <!-- EnableMetrics: registering the engine's meter (and the OTLP export Aspire/collectors pick up)
             is a one-liner the host would otherwise have to write itself. -->
        <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
        <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\x86cc.RippleEngine.Core\x86cc.RippleEngine.Core.csproj" />
        <ProjectReference Include="..\x86cc.RippleEngine.Storage\x86cc.RippleEngine.Storage.csproj" />
        <ProjectReference Include="..\x86cc.RippleEngine.Engine\x86cc.RippleEngine.Engine.csproj" />
        <!-- Brings the ASP.NET Core framework reference with it: EnableDashboard maps endpoints, so this
             package can only be consumed by a host that has the ASP.NET Core shared runtime. -->
        <ProjectReference Include="..\x86cc.RippleEngine.Dashboard\x86cc.RippleEngine.Dashboard.csproj" />
    </ItemGroup>

</Project>
