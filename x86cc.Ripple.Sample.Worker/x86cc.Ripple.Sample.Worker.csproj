<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <UserSecretsId>dotnet-x86cc.Ripple.Sample.Worker-280e45ba-0b8c-4cff-a410-8d63b58a819b</UserSecretsId>
        <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    </PropertyGroup>

    <ItemGroup>
        <!-- One reference: Hosting brings the engine, the storage and the dashboard (SPA included) with it. -->
        <ProjectReference Include="..\x86cc.RippleEngine.Hosting\x86cc.RippleEngine.Hosting.csproj" />
        <ProjectReference Include="..\x86cc.Ripple.Sample.Domain\x86cc.Ripple.Sample.Domain.csproj" />
    </ItemGroup>

    <ItemGroup>
      <Content Include="..\.dockerignore">
        <Link>.dockerignore</Link>
      </Content>
    </ItemGroup>

    <!-- The Angular dashboard is built and embedded by x86cc.RippleEngine.Dashboard now (see its csproj);
         nothing SPA-related is left in this sample. -->
</Project>
